<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- legacy code is not null-annotated; enabling nullable here is warning noise,
         not value. Left disabled for a clean .NET 8 build; annotate as a follow-up. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>wuh</RootNamespace>
    <AssemblyName>wuh</AssemblyName>
    <StartupObject>wuh.Program</StartupObject>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- keep the existing Properties/AssemblyInfo.cs; don't double-generate attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Program.cs is a dead duplicate of the Program class in wuh.cs (it was excluded
       from the pre-SDK build too). SDK-style auto-includes all .cs, so exclude it
       explicitly to avoid a duplicate Main/Program. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <!-- Windows Update Agent COM API. wuapi.dll ships with Windows (incl. CI runners),
       so this resolves and embeds at build time. -->
  <ItemGroup>
    <COMReference Include="WUApiLib">
      <Guid>{B596CC9F-56E5-419E-A622-E01BB457431E}</Guid>
      <VersionMajor>2</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

</Project>
